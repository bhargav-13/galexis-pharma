{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/business", "destination": "/services", "permanent": true },
    { "source": "/human-pharma", "destination": "/products", "permanent": true },
    { "source": "/vet-pharma", "destination": "/products", "permanent": true },
    { "source": "/nutraceuticals", "destination": "/products", "permanent": true },
    { "source": "/import-export", "destination": "/export", "permanent": true },
    { "source": "/rnd", "destination": "/manufacturing", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/brand/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
